# ──────────────────────────────────────
# Database
# ──────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/openclaw

# ──────────────────────────────────────
# NextAuth.js
# ──────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ──────────────────────────────────────
# Stripe API Keys
# Get these from https://dashboard.stripe.com/apikeys
# ──────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Stripe Price IDs
# Create these in the Stripe Dashboard under Products > Pricing
# BYOK: a single recurring price (e.g., $29/month)
STRIPE_BYOK_PRICE_ID=price_...

# Managed AI: base recurring price (e.g., $49/month)
STRIPE_MANAGED_BASE_PRICE_ID=price_...

# Managed AI: metered usage price (e.g., $0.50 per 1K requests)
# Set this up as a metered/usage-based price in Stripe
STRIPE_MANAGED_METERED_PRICE_ID=price_...

# Stripe Webhook Secret
# Get this after creating a webhook endpoint in Stripe Dashboard
# Endpoint URL: https://yourdomain.com/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ──────────────────────────────────────
# Application
# ──────────────────────────────────────
APP_URL=http://localhost:3000

# Comma-separated list of emails that get admin role on signup
ADMIN_EMAILS=admin@example.com

# ──────────────────────────────────────
# OpenClaw Backend (for real integration — not needed for placeholder)
# ──────────────────────────────────────
# OPENCLAW_API_URL=https://api.openclaw.app
# OPENCLAW_API_KEY=oc_...
