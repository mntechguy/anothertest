# Stripe API Keys
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Stripe Price IDs
# Create these in the Stripe Dashboard under Products > Pricing
# BYOK: a single recurring price (e.g., $29/month)
STRIPE_BYOK_PRICE_ID=price_...

# Managed AI: base recurring price (e.g., $49/month)
STRIPE_MANAGED_BASE_PRICE_ID=price_...

# Managed AI: metered usage price (e.g., $0.50 per 1K requests)
# Set this up as a metered/usage-based price in Stripe
STRIPE_MANAGED_METERED_PRICE_ID=price_...

# Stripe Webhook Secret
# Get this after creating a webhook endpoint in Stripe Dashboard
# Endpoint URL: https://yourdomain.com/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Application URL
APP_URL=http://localhost:3000
